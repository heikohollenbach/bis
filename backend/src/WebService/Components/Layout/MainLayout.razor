@inherits LayoutComponentBase

<RadzenComponents />

<RadzenLayout Style="min-height: 100vh;">
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Style="padding: 1rem 1.5rem;">
            <RadzenLabel>
                <RadzenIcon Icon="rocket" />
                BIS - Being in Space
            </RadzenLabel>
            <RadzenLink Path="/privacy" Text="Privacy" />
        </RadzenStack>
    </RadzenHeader>

    <RadzenBody>
        <RadzenDialog />
        <RadzenNotification />
        <RadzenContextMenu />
        <RadzenTooltip />
        @Body
    </RadzenBody>
</RadzenLayout>
