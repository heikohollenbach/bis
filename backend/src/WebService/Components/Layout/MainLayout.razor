@inherits LayoutComponentBase

<RadzenComponents />

<RadzenLayout Style="min-height: 100vh;">
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Style="padding: 1rem 1.5rem;">
            <RadzenLabel>BIS - Being in Space</RadzenLabel>
            <RadzenLink Path="/privacy" Text="Privacy" />
        </RadzenStack>
    </RadzenHeader>

    <RadzenBody Style="padding: 1.5rem;">
        <RadzenDialog />
        <RadzenNotification />
        <RadzenContextMenu />
        <RadzenTooltip />
        @Body
    </RadzenBody>

    <RadzenFooter>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="padding: 1rem;">
            <RadzenText TextStyle="TextStyle.Body2">© @DateTime.Now.Year BIS - Being in Space</RadzenText>
        </RadzenStack>
    </RadzenFooter>
</RadzenLayout>
