@page "/"

<PageTitle>BIS - Being in Space</PageTitle>

<section class="hero">
    <div class="container">
        <h1>BIS - Being in Space</h1>
        <p class="subtitle">
            Erkunde das Universum, baue deine Existenz auf und ueberlebe im Weltraum.
        </p>

        <div class="cta-group">
            <a href="#cta" class="btn primary">Jetzt starten</a>
            <a href="#features" class="btn secondary">Mehr erfahren</a>
        </div>
    </div>
</section>

<section id="features" class="features">
    <div class="container">
        <h2>Features</h2>

        <div class="grid">
            <div class="card">
                <h3>Offene Galaxie</h3>
                <p>Reise frei durch ein dynamisches Universum mit unendlichen Moeglichkeiten.</p>
            </div>

            <div class="card">
                <h3>Echtzeit-System</h3>
                <p>Erlebe eine persistente Welt mit anderen Spielern und Live-Events.</p>
            </div>

            <div class="card">
                <h3>Interstellar Travel</h3>
                <p>Springe zwischen Sternensystemen und entdecke neue Welten.</p>
            </div>
        </div>
    </div>
</section>

<section id="cta" class="cta">
    <div class="container">
        <h2>Bereit fuer dein Abenteuer?</h2>
        <p>Starte jetzt deine Reise im BIS-Universum.</p>

        <a href="/auth/login" class="btn primary large">
            Account erstellen
        </a>
    </div>
</section>
