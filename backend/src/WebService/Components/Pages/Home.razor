@page "/"

<PageTitle>BIS - Being in Space</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenCard Variant="Variant.Filled" Style="padding: 2rem;">
        <RadzenStack Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1">BIS - Being in Space</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1">
                Erkunde das Universum, baue deine Existenz auf und ueberlebe im Weltraum.
            </RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem">
                <a href="/auth/login"><RadzenButton Text="Jetzt starten" ButtonStyle="ButtonStyle.Primary" /></a>
                <a href="/privacy"><RadzenButton Text="Mehr erfahren" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" /></a>
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>

    <RadzenStack Gap="0.75rem">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H2">Features</RadzenText>

        <RadzenRow Gap="16px">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H3">Offene Galaxie</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2">Reise frei durch ein dynamisches Universum mit unendlichen Moeglichkeiten.</RadzenText>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H3">Echtzeit-System</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2">Erlebe eine persistente Welt mit anderen Spielern und Live-Events.</RadzenText>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H3">Interstellar Travel</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2">Springe zwischen Sternensystemen und entdecke neue Welten.</RadzenText>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
    </RadzenStack>

    <RadzenCard Style="padding: 1.5rem;">
        <RadzenStack Gap="0.5rem" AlignItems="AlignItems.Start">
            <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2">Bereit fuer dein Abenteuer?</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2">Starte jetzt deine Reise im BIS-Universum.</RadzenText>
            <a href="/auth/login"><RadzenButton Text="Account erstellen" Size="ButtonSize.Large" ButtonStyle="ButtonStyle.Primary" /></a>
        </RadzenStack>
    </RadzenCard>
</RadzenStack>
