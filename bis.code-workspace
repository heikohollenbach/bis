{
  "folders": [
    {
      "path": ".",
      "name": "Git",
    },
  ],
  "settings": {
    "prettier.printWidth": 160,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always",
    },
    "editor.linkedEditing": true,
    "explorer.fileNesting.enabled": true,
    "containers.containers.groupBy": "Compose Project Name",
    "containers.containers.label": "ContainerName",
    "containers.containers.description": ["Image", "Status"],
    "containers.containers.sortBy": "Label",
    "search.exclude": {
      "**/bin": true,
      "**/obj": true,
    },
    "workbench.colorCustomizations": {
      "activityBar.activeBackground": "#1a1a1a",
      "activityBar.background": "#1a1a1a",
      "activityBar.foreground": "#e7e7e7",
      "activityBar.inactiveForeground": "#e7e7e799",
      "activityBarBadge.background": "#606020",
      "activityBarBadge.foreground": "#e7e7e7",
      "commandCenter.border": "#e7e7e799",
      "sash.hoverBorder": "#1a1a1a",
      "statusBar.background": "#000000",
      "statusBar.foreground": "#e7e7e7",
      "statusBarItem.hoverBackground": "#1a1a1a",
      "statusBarItem.remoteBackground": "#000000",
      "statusBarItem.remoteForeground": "#e7e7e7",
      "titleBar.activeBackground": "#000000",
      "titleBar.activeForeground": "#e7e7e7",
      "titleBar.inactiveBackground": "#00000099",
      "titleBar.inactiveForeground": "#e7e7e799"
    },
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "rvest.vs-code-prettier-eslint",
      "hediet.vscode-drawio",
      "johnpapa.vscode-peacock",
      "ms-dotnettools.csdevkit",
      "ms-dotnettools.csharp",
      "sonarsource.sonarlint-vscode",
      "pkief.material-icon-theme",
      "ms-azuretools.vscode-containers",
      "aliasadidev.nugetpackagemanagergui",
      "tchayen.markdown-links",
    ],
  },
}
