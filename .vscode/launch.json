  "version": "0.2.0",
  "compounds": [
    {
      "name": "All",
      "configurations": ["AuthService (dll)", "ChatService (dll)", "PlayerService (dll)", "WebService (dll)", "WorldService (dll)"],
      "preLaunchTask": "build",
      "stopAll": true,
      "presentation": {
        "group": "00"
      }
    }
  ],
  "configurations": [
    {
      "name": "Attach to Unity",
      "type": "vstuc",
      "request": "attach"
    },
    {
      "name": "AuthService (dll)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/backend/src/AuthService/bin/Debug/net10.0/BIS.AuthService.dll",
      "cwd": "${workspaceFolder}/backend/src/AuthService",
      "args": [],
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://0.0.0.0:5001"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:.*http://[^\\s:]+:([0-9]+).*",
        "uriFormat": "http://localhost:%s/swagger"
      },
      "presentation": {
        "group": "01"
      }
    },
    {
      "name": "ChatService (dll)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/backend/src/ChatService/bin/Debug/net10.0/BIS.ChatService.dll",
