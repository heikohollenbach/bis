{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "pwsh",
      "args": ["-Command", "dotnet build backend"]
    },
    {
      "label": "watch: WebService",
      "type": "shell",
      "command": "dotnet watch --project backend/src/WebService",
      "options": {
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      },
      "problemMatcher": {
        "owner": "dotnet-watch",
        "pattern": {
          "regexp": "^\\s*$",
          "file": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "dotnet watch",
          "endsPattern": "Now listening on:"
        }
      }
    }
  ]
}
